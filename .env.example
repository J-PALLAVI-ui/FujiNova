# =====================================================================
# FujiNova — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      Copy-Item .env.example .env
# 2. Populate your authentic API keys below.
# 3. NEVER commit your actual '.env' file or paste credentials in chat.
# =====================================================================

# Server Environment
FUJINOVA_ENV=development
FUJINOVA_HOST=127.0.0.1
FUJINOVA_PORT=8000
DATABASE_URL=sqlite:///./fujinova.db

# Model Provider Routing (Documented development defaults)
# Primary options: 'google' (default), 'openai', 'ollama'
FUJINOVA_PRIMARY_PROVIDER=google
FUJINOVA_PRIMARY_MODEL=gemini-3.8-flash

# Failover Provider (Activated only if primary fails and multi-vendor failover is permitted)
FUJINOVA_FALLBACK_PROVIDER=openai
FUJINOVA_FALLBACK_MODEL=gpt-4o-mini

# Operational Safeguards
FUJINOVA_MAX_RETRIES=2
FUJINOVA_TIMEOUT_SECONDS=12.0
FUJINOVA_TEMPERATURE=0.3

# Privacy Policy Gate:
# Set to 'false' to prevent sending user prompts to secondary vendors if Gemini fails.
ALLOW_MULTI_VENDOR_FAILOVER=true

# ---------------------------------------------------------------------
# Provider API Credentials (SERVER-SIDE ONLY - Never expose to client)
# ---------------------------------------------------------------------

# Google AI Studio API Key
# Sign up & generate key: https://aistudio.google.com/app/apikey
# PRIVACY NOTICE: On the free tier, Google may process prompts/responses
# for model improvement. For production or sensitive data, use Vertex AI.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional secondary fallback)
# Generate key: https://platform.openai.com/api-keys
# Requires a funded billing balance (minimum $5 prepaid deposit).
OPENAI_API_KEY=your_openai_api_key_here
